{
  "name": "casegrid",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @casegrid/web dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @casegrid/web test:e2e",
    "typecheck": "pnpm -r --if-present run typecheck",
    "validate:puzzles": "pnpm --filter @casegrid/puzzle-engine validate:puzzles"
  }
}
